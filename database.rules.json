{
  "rules": {
    ".read": false,
    ".write": false,
    "assortment": {
      "meta": {
        ".read": true,
        "initialized": {
          ".write": "auth != null && (!data.exists() || (auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true && (root.child('assortment/users/'+auth.uid+'/role').val() === 'admin')))"
        }
      },
      "users": {
        ".read": "auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true && (root.child('assortment/users/'+auth.uid+'/role').val() === 'admin')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true && (root.child('assortment/users/'+auth.uid+'/role').val() === 'admin')) || (auth != null && auth.uid === $uid && !root.child('assortment/meta/initialized').exists())",
          ".validate": "newData.hasChildren(['name','email','role'])",
          "role": {
            ".validate": "newData.val() === 'admin' || newData.val() === 'planner' || newData.val() === 'shift' || newData.val() === 'viewer'"
          }
        }
      },
      "plan": {
        ".read": "auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true",
        ".write": "auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true && (root.child('assortment/users/'+auth.uid+'/role').val() === 'admin' || root.child('assortment/users/'+auth.uid+'/role').val() === 'planner')"
      },
      "log": {
        ".read": "auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true",
        ".write": "auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true && (root.child('assortment/users/'+auth.uid+'/role').val() === 'admin' || root.child('assortment/users/'+auth.uid+'/role').val() === 'planner' || root.child('assortment/users/'+auth.uid+'/role').val() === 'shift')"
      },
      "audit": {
        ".read": "auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true",
        ".indexOn": [
          "ts"
        ],
        "$id": {
          ".write": "auth != null && root.child('assortment/users/'+auth.uid).exists() && root.child('assortment/users/'+auth.uid+'/disabled').val() !== true && (root.child('assortment/users/'+auth.uid+'/role').val() === 'admin' || root.child('assortment/users/'+auth.uid+'/role').val() === 'planner' || root.child('assortment/users/'+auth.uid+'/role').val() === 'shift') && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['ts','uid','name','day','kind','id','from','to'])"
        }
      }
    },
    "hrhub": {
      "meta": {
        ".read": true,
        "initialized": {
          ".write": "auth != null && (!data.exists() || (auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin'))"
        }
      },
      "users": {
        ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin') || (auth != null && auth.uid === $uid && !root.child('hrhub/meta/initialized').exists())",
          ".validate": "newData.hasChildren(['name','email','role'])",
          "role": {
            ".validate": "newData.val() === 'admin' || newData.val() === 'hr' || newData.val() === 'staff'"
          }
        }
      },
      "requests": {
        ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin'",
        "$uid": {
          ".write": "(auth != null && auth.uid === $uid) || (auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin')"
        }
      },
      "data": {
        ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && (root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin' || root.child('hrhub/users/'+auth.uid+'/role').val() === 'hr')",
        ".write": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && (root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin' || root.child('hrhub/users/'+auth.uid+'/role').val() === 'hr')",
        "leave": {
          ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true",
          "$id": {
            ".write": "(auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && (root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin' || root.child('hrhub/users/'+auth.uid+'/role').val() === 'hr')) || (auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && !data.exists() && newData.child('status').val() === 'Pending' && newData.child('submittedBy').val() === auth.uid) || (auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && data.child('submittedBy').val() === auth.uid && data.child('status').val() === 'Pending' && newData.child('status').val() === 'Cancelled')"
          }
        },
        "notices": {
          ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true"
        },
        "settings": {
          ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true"
        }
      },
      "files": {
        ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && (root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin' || root.child('hrhub/users/'+auth.uid+'/role').val() === 'hr')",
        ".write": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && (root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin' || root.child('hrhub/users/'+auth.uid+'/role').val() === 'hr')"
      },
      "public": {
        ".read": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true",
        ".write": "auth != null && root.child('hrhub/users/'+auth.uid).exists() && root.child('hrhub/users/'+auth.uid+'/disabled').val() !== true && (root.child('hrhub/users/'+auth.uid+'/role').val() === 'admin' || root.child('hrhub/users/'+auth.uid+'/role').val() === 'hr')"
      }
    }
  }
}